# ─────────────────────────────────────────────
# TruthGuard v2 — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# App
APP_ENV=development
SECRET_KEY=change-me-to-a-random-32-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Database ─────────────────────────────────
# Option A: Local SQLite (works offline, zero setup)
DATABASE_URL=sqlite+aiosqlite:///./truthguard.db

# Option B: Supabase PostgreSQL
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres

# ─── LLM Provider ─────────────────────────────
# mock    → deterministic responses, no API key needed (good for demo)
# openai  → requires OPENAI_API_KEY
# ollama  → requires local Ollama running
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ─── Embedding Provider ───────────────────────
# mock   → random vectors, no model download (semantic search disabled)
# local  → sentence-transformers all-MiniLM-L6-v2 (free, ~80MB download)
# openai → requires OPENAI_API_KEY
EMBEDDING_PROVIDER=local

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384            # 384 for MiniLM, 1536 for OpenAI small

# ─── pgvector ─────────────────────────────────
# true  → use pgvector for fast ANN search (PostgreSQL only)
# false → compute cosine similarity in Python (works on SQLite too)
PGVECTOR_ENABLED=false

# ─── Admin seed user ──────────────────────────
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Demo Admin

# ─── CORS ─────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173
